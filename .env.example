# Sao chép thành .env rồi sửa; `pnpm start` tự đọc file .env (không commit .env).
APP_ENV=development
DATABASE_URL=postgres://whr:whr@localhost:5432/whr
API_ADDR=:8080
ALLOW_INSECURE_HTTP=false
IDEMPOTENCY_TTL=24h
SSRF_ALLOWLIST=
# Worker (`pnpm worker`): xem spec/13. RETRY_DELAYS có MAX_ATTEMPTS - 1 phần tử.
WORKER_CONCURRENCY=200
WORKER_IDLE_SLEEP=200ms
REQUEST_TIMEOUT=10s
CONNECT_TIMEOUT=3s
LEASE_DURATION=30s
MAX_ATTEMPTS=8
RETRY_DELAYS=5s,5m,30m,2h,5h,10h,10h
